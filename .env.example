# Growlyze Multimodal AI Chat - environment configuration
# Copy to .env (cp .env.example .env), fill in, keep it private (chmod 600).
# .env is gitignored; never commit real values.
#
# Keep comments on their own lines: ops/backup.sh and ops/repoctl.py read
# some values from this file directly, and a trailing "# comment" would
# become part of the value.
#
# Generate random secrets with:   openssl rand -hex 32

# ================================ CORE ================================
# Required. `docker compose` refuses to start while any of these is empty.

# Postgres password (Open WebUI database + haystack-api DATABASE_URL)
POSTGRES_PASSWORD=change-me-postgres-password
# Signs Open WebUI sessions
WEBUI_SECRET_KEY=change-me-webui-secret-key
# Key Open WebUI uses for the haystack-api content loader;
# must match Admin -> Settings -> Documents -> External API Key
EXTERNAL_LOADER_API_KEY=change-me-external-loader-key
# Admin API key between the dashboard and haystack-api (Authorization: Bearer ...)
ADMIN_API_KEY=change-me-admin-api-key
# Read-only key the code sandbox uses to load stored datasets (never the admin key)
DATA_API_KEY=change-me-data-api-key
# Embedding provider key; without it every stored vector is noise
EMBEDDING_API_KEY=change-me-embedding-api-key
# Code-execution sandbox API key (also entered in Open WebUI's Open Terminal settings)
OPEN_TERMINAL_API_KEY=change-me-open-terminal-key
# Phoenix (tracing UI at /traces/) auth secret and first-boot admin password
PHOENIX_SECRET=change-me-phoenix-secret
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=change-me-phoenix-admin-password

# Public hostname Caddy serves (DNS A record must point at this server)
DOMAIN=chat.example.com
# Public base URL of this deployment (links, Google OAuth redirect)
PUBLIC_BASE_URL=https://chat.example.com

# Dashboard (https://DOMAIN/kb/) login
# Signs dashboard session cookies (32+ random characters)
SESSION_SECRET=change-me-session-secret
ADMIN_USERNAME=admin
# PBKDF2 hash of the dashboard password. Generate it with:
#   python3 -c "import hashlib,os,sys;s=os.urandom(16).hex();i=310000;print('pbkdf2_sha256:%d:%s:%s'%(i,s,hashlib.pbkdf2_hmac('sha256',sys.argv[1].encode(),s.encode(),i).hex()))" 'your-password'
# and paste the printed pbkdf2_sha256:... line here. (A plain sha256 hex
# digest is also accepted.) A placeholder value keeps the login disabled.
ADMIN_PASSWORD_HASH=change-me-run-the-command-above

# ============================== FEATURE ===============================
# Needed only for the feature named. The stack boots without them.

# Google AI Studio key: Gemini chat models (LiteLLM) and video/image descriptions
GOOGLE_API_KEY=
# Anthropic key: Claude chat models (LiteLLM) and the query-planner fallback
ANTHROPIC_API_KEY=
# Separate Anthropic key for the query planner (optional; defaults to ANTHROPIC_API_KEY)
PLANNER_ANTHROPIC_API_KEY=
# Groq key: audio/video transcription (Whisper)
GROQ_API_KEY=
# Reranker key (retrieval reranking)
RERANKER_API_KEY=
# Voyage key (LiteLLM Voyage models)
VOYAGE_API_KEY=
# Phoenix project API key so services can send traces (create it in the Phoenix UI)
PHOENIX_API_KEY=

# Backups (ops/backup.sh, ops/repoctl.py on the host - see README.md)
# restic repository encryption password (openssl rand -base64 48). Keep a copy offline.
RESTIC_PASSWORD=
# restic repository, an rclone backend, e.g. rclone:gdrive:backups
RESTIC_REPOSITORY=

# ====================== OPTIONAL INTEGRATIONS / TUNING ======================
# Everything below can stay empty; the platform runs without it.

# --- Google Drive (optional) ---
# OAuth "Web application" client for the dashboard's Drive sign-in. Empty =
# Integrations shows "not configured" and no Drive feature is offered.
# Register https://DOMAIN/kb/api/drive/callback as the client's redirect URI.
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
# Override the redirect URI (default: PUBLIC_BASE_URL + /kb/api/drive/callback)
DRIVE_OAUTH_REDIRECT_URI=
# Default Drive folder the intake scans until one is chosen in the dashboard
DRIVE_INTAKE_FOLDER_ID=
# Drive connection record applied by Drive intake (written by the dashboard)
DRIVE_INTAKE_DRIVE_OVERRIDE=/data/backup-drives/primary.json

# --- Video ---
# Channel scanned by "Discover videos" when no channel is entered
VIDEO_DISCOVERY_CHANNEL_URL=
# Gemini service tier for frame descriptions (flex = half price) and parallel workers
VIDEO_DESC_SERVICE_TIER=flex
VIDEO_VISION_WORKERS=16

# --- Deployment / branding ---
# Prefix for the Compose project, container and network names (unique per client on one host)
STACK_NAME=gmac
# Host folder for all persistent data (database, vectors, uploads, certificates).
# On macOS/Windows (Docker Desktop) use a folder Docker can share, e.g. ./data
DATA_DIR=/data
# Host folder holding rclone.conf for the optional Google Drive features
# (e.g. ./data/rclone on macOS/Windows). No rclone.conf = Drive intake off.
RCLONE_CONFIG_DIR=/root/.config/rclone
# Where this repository lives on a Linux host; used only by the host-side
# backup scripts and systemd units in ops/
INSTALL_DIR=/opt/gmac
# Product name shown in Open WebUI (WEBUI_NAME), the dashboard and Drive folder names
APP_NAME=Growlyze Multimodal AI Chat
# Browser origins allowed to call haystack-api directly (comma-separated). Empty = none.
CORS_ORIGINS=
# Comma-separated domain terms injected into extraction prompts
DOMAIN_JARGON=

# --- Code sandbox limits (size to the host) ---
SANDBOX_MEM_LIMIT=12g
SANDBOX_CPUS=4.0
