{
  "description": "Domain-neutral retrieval test set. Layer 3 runs every query through GET /search and scores precision@5, recall@10, MRR and jargon hit rate against these expectations. Schema per case: query (str), difficulty (str: basic | jargon-abbreviation | cross-collection | code | specific | video-retrieval | video-timestamp), expected_keywords_in_result ([str]), optional expected_source_type (str), optional expected_collections ([str]), optional expected_has_timestamp (bool).",
  "targets": {
    "precision_at_5": 0.8,
    "recall_at_10": 0.85,
    "mrr": 0.7,
    "jargon_hit_rate": 0.9
  },
